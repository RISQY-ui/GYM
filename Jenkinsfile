pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Code sudah diambil dari GitHub oleh Jenkins.'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing HTML project...'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploy HTML project...'
            }
        }
    }
}